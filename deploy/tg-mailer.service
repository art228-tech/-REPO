[Unit]
Description=Telegram multi-account mailer bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tg-mailer
EnvironmentFile=/opt/tg-mailer/.env
ExecStart=/opt/tg-mailer/.venv/bin/python /opt/tg-mailer/main.py
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
