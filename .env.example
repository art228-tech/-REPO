# --- обязательные ---

# Токен бота от @BotFather.
BOT_TOKEN=

# Ключ шифрования сессий: python -m tgparser genkey
# Потеряете — сохранённую сессию будет не расшифровать, аккаунт придётся
# подключать заново.
SESSION_ENCRYPTION_KEY=

# --- ключи приложения (необязательно) ---

# api_id и api_hash идентифицируют приложение, а не аккаунт: программа сначала
# предъявляет их серверу и только потом передаёт номер и код. У официальных
# клиентов такие ключи тоже есть, просто вшиты внутрь.
#
# Заполнять не обязательно: при подключении аккаунта бот умеет получить ключи
# сам через my.telegram.org, либо пользователь вводит свои руками. Заданные
# здесь работают как общие по умолчанию для всех.
#
# Публичные ключи из интернета не подходят: Telegram блокирует засвеченные,
# они ловят API_ID_PUBLISHED_FLOOD.
# API_ID=
# API_HASH=

# --- доступ ---

# open      — бот доступен любому, у каждого своя изолированная база.
# allowlist — только перечисленным id, тогда обязателен ALLOWED_USER_IDS.
ACCESS_MODE=open

# Через запятую, только для режима allowlist.
# ALLOWED_USER_IDS=123456789,987654321

# Необязательный администратор: команда /admin со сводкой по всем
# пользователям. Свой id можно узнать у @userinfobot.
# ADMIN_ID=

# --- необязательные ---

# DB_PATH=/app/data/tgparser.sqlite3
# EXPORT_DIR=/app/data/exports

# Отпечаток клиента. Чем правдоподобнее, тем меньше внимания антиспама.
# DEVICE_MODEL=Desktop
# SYSTEM_VERSION=Windows 10
# APP_VERSION=5.7.1

# LOG_LEVEL=INFO
