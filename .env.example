# Telegram bot configuration
# Copy this file to ".env" and fill in the real values.
# Never commit your real .env file — it contains secrets.

# Bot token issued by @BotFather
BOT_TOKEN=123456:your-bot-token-here

# Telegram user id(s) with admin rights.
# Use a single id, or several separated by commas: 111111,222222
ADMIN_IDS=8246986597

# Path to the SQLite database file used to store known users.
DB_PATH=data/bot.sqlite3
