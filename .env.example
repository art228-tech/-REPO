# --- Telegram API (для входа в аккаунт через Telethon) ---
# МОЖНO НЕ ЗАПОЛНЯТЬ: по умолчанию используются публичные ключи Telegram Desktop,
# софт запустится и так. НО с публичными ключами выше риск ограничений/банов.
# Для надёжной работы получите свои на https://my.telegram.org и впишите ниже.
API_ID=
API_HASH=

# --- Параметры парсинга ---
# Минимальное число участников для базы "без ограничений"
MIN_MEMBERS=1000
# Пауза между проверками чатов (секунды) — чтобы не словить лимиты ТГ
CHECK_INTERVAL=25
# Сколько секунд ждём ответ бота-модератора после точки
PROBE_WAIT=12
# Путь к базе данных
DB_PATH=data/parser.db

