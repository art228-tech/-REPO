# --- Telegram API (для входа в аккаунт через Telethon) ---
# МОЖНO НЕ ЗАПОЛНЯТЬ: в config.py зашиты рабочие ключи по умолчанию.
# Чтобы использовать другие — впишите свои (https://my.telegram.org).
API_ID=
API_HASH=

# --- Параметры парсинга (стартовые значения; меняются и из бота) ---
# Минимальное число участников для базы "без ограничений"
MIN_MEMBERS=1000
# Минимальное число сообщений в сутки для базы "без ограничений"
MIN_MESSAGES_PER_DAY=50
# Сколько последних сообщений берём для оценки активности
ACTIVITY_SAMPLE=60
# Пауза между проверками чатов (секунды) — чтобы не словить лимиты ТГ
CHECK_INTERVAL=25
# Сколько секунд ждём ответ бота-модератора после точки
PROBE_WAIT=12
# Путь к базе данных
DB_PATH=data/parser.db

