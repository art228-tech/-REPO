# Порт локального веб-интерфейса
PORT=4599

# Хост локального API Dolphin Anty (по умолчанию приложение слушает 3001)
DOLPHIN_LOCAL_API=http://localhost:3001

# Базовый URL облачного (remote) API Dolphin Anty
DOLPHIN_REMOTE_API=https://dolphin-anty-api.com

# API-токен Dolphin Anty (можно также указать в UI перед запуском).
# Получается на https://dolphin-anty.com/panel в разделе API.
DOLPHIN_API_TOKEN=

# Директория для конфигов/логов/состояния
DATA_DIR=./data
