# --- обязательные ---

# Токен бота от @BotFather.
BOT_TOKEN=

# api_id и api_hash приложения с https://my.telegram.org
# → API development tools → Create application.
# Идентифицируют приложение, а не аккаунт: без них MTProto не пустит.
# Публичные ключи из интернета не подходят — они ловят API_ID_PUBLISHED_FLOOD.
API_ID=
API_HASH=

# Ваш Telegram user id. Бот отвечает только ему, остальным молчит.
# Узнать можно у @userinfobot.
OWNER_ID=

# Ключ шифрования сессий: python -m tgparser genkey
# Потеряете — сохранённую сессию будет не расшифровать, аккаунт придётся
# подключать заново.
SESSION_ENCRYPTION_KEY=

# --- необязательные ---

# DB_PATH=/app/data/tgparser.sqlite3
# EXPORT_DIR=/app/data/exports

# Отпечаток клиента. Чем правдоподобнее, тем меньше внимания антиспама.
# DEVICE_MODEL=Desktop
# SYSTEM_VERSION=Windows 10
# APP_VERSION=5.7.1

# LOG_LEVEL=INFO
