# Токен главного бота-конструктора (получить у @BotFather)
BOT_TOKEN=1234567890:AAAA-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB

# ID администраторов через запятую (узнать у @userinfobot)
ADMIN_IDS=123456789

# Путь к базе (по умолчанию data.db рядом с main.py)
DB_PATH=data.db

# Публичный URL веб-приложения для рулетки (ОБЯЗАТЕЛЬНО HTTPS!)
# Например: https://mydomain.com
WEBAPP_URL=https://your-domain.com

# Хост и порт, на которых будет слушать веб-сервер
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
